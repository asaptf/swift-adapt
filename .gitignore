# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# Generated MLX metallib for AdaptTrainTests (see scripts/ensure-mlx-metal-library.sh).
# Primary cache lives under .build/ (already ignored); keep an explicit rule so
# a future path change outside .build cannot reintroduce a tracked blob.
**/default.metallib
Tests/AdaptTrainTests/MetalSupport/

# Demo registry from scripts/seed-demo-registry.sh (~200 MB of adapter weights).
# Derive it; do not vendor (same rule as the Metal library).
.build/demo-registry/
.build/demo-slices/

